# Swaylock Configuration

# Background
color=1e1e2e

# Font
font=JetBrainsMono Nerd Font
font-size=128

# Clock
clock
timestr=%H:%M:%S

# Indicator appearance
indicator
indicator-radius=180
indicator-thickness=20

# Show failed login attempts
#show-failed-attempts
#show-keyboard-layout

# Indicator states - using Rose Pine inspired colors
# Default state
#inside-color=191724
#ring-color=31748f
#line-color=1f1d2e
#text-color=e0def4

# When typing
#inside-clear-color=1f1d2e
#ring-clear-color=9ccfd8
#line-clear-color=1f1d2e
#text-clear-color=e0def4

# When verifying password
#inside-ver-color=1f1d2e
#ring-ver-color=c4a7e7
#line-ver-color=1f1d2e
#text-ver-color=e0def4

# When password is wrong
#inside-wrong-color=1f1d2e
#ring-wrong-color=eb6f92
#line-wrong-color=1f1d2e
#text-wrong-color=eb6f92

# Caps lock state
#inside-caps-lock-color=1f1d2e
#ring-caps-lock-color=f6c177
#line-caps-lock-color=1f1d2e
#text-caps-lock-color=e0def4

# Separator color
#separator-color=1f1d2e

# Other settings
ignore-empty-password
daemonize

color=1e1e2e
bs-hl-color=dc8a78
caps-lock-bs-hl-color=dc8a78
caps-lock-key-hl-color=40a02b
inside-color=00000000
inside-clear-color=00000000
inside-caps-lock-color=00000000
inside-ver-color=00000000
