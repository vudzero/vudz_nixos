# Vanilla Swaylock Configuration
# Compatible with plain swaylock (not swaylock-effects)

# Solid background color
color=1e1e2e

# Show helpful information
show-failed-attempts
indicator-caps-lock

# Make indicator always visible (even when idle)
indicator-idle-visible

# Basic settings
ignore-empty-password
daemonize

# Font settings
font=JetBrainsMono Nerd Font
font-size=24

# Larger, more visible indicator
indicator-radius=120
indicator-thickness=15

# Blue color scheme
# Default state
inside-color=1a1f3a
ring-color=4169e1
text-color=a8c5e0

# Verifying password
inside-ver-color=1a1f3a
ring-ver-color=1e90ff
text-ver-color=87ceeb

# Wrong password
inside-wrong-color=1a1f3a
ring-wrong-color=000080
text-wrong-color=4682b4

# Typing/cleared
inside-clear-color=1a1f3a
ring-clear-color=6495ed
text-clear-color=b0d4f1
