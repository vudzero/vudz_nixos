configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Adwaita";
    display-drun: "Applications";
    display-run: "Run";
    display-window: "Windows";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 12";
}

* {
    bg: #1e1e2e;
    fg: #cdd6f4;
    border: #89b4fa;
    selected: #313244;

    background-color: @bg;
    text-color: @fg;
}

window {
    border: 2px;
    border-color: @border;
    border-radius: 8px;
    padding: 0px;
    title: false;
}

mainbox {
    spacing: 0px;
}

inputbar {
    padding: 10px;
    border-radius: 4px;
    background-color: @selected;
    children: [entry];
}

listview {
    lines: 10;
    padding: 10px 0px;
}

element {
    padding: 8px;
    border-radius: 4px;
    background-color: transparent;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @selected;
    text-color: @fg;
}

element-icon {
    size: 24px;
    padding: 0px 10px 0px 0px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

entry {
    text-color: #ffffff; /* White color for the text you type */
    placeholder-color: #cccccc; /* Light gray for the placeholder text */
    padding: 12px;
    border-radius: 12px;
}
