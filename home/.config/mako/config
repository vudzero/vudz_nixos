# Mako notification daemon configuration

# Position notifications in the top-right corner
anchor=top-right

# Visual styling
font=monospace 10
background-color=#2e3440
text-color=#d8dee9
border-color=#0080ff
border-size=2
border-radius=0

# Notification dimensions
width=300
height=100
margin=10
padding=10

# Behavior
default-timeout=5000
ignore-timeout=0

# Group notifications
group-by=app-name
