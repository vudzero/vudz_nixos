{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,

  "modules-left": ["hyprland/workspaces"],
  "modules-right": ["tray", "cpu", "temperature", "custom/gpu", "custom/gpu-temp", "memory", "disk", "pulseaudio", "clock"],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "format": "{name}",
    "all-outputs": true,
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": []
    }
  },

  "cpu": {
    "format": "CPU {usage}%",
    "interval": 2,
    "tooltip": false
  },

  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
    "critical-threshold": 80,
    "format": "{temperatureC}°C",
    "interval": 2,
    "tooltip": false
  },

  "custom/gpu": {
    "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits | awk '{print \"GPU \" $1\"%\"}'",
    "interval": 2,
    "tooltip": false
  },

  "custom/gpu-temp": {
    "exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits | awk '{print $1\"°C\"}'",
    "interval": 2,
    "tooltip": false
  },

  "memory": {
    "format": "RAM {used:0.1f}G",
    "interval": 2,
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G ({percentage}%)"
  },

  "disk": {
    "format": "Disk {percentage_used}%",
    "interval": 30,
    "path": "/",
    "tooltip-format": "Used: {used} / {total}"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "🔇 {volume}%",
    "format-icons": {
      "default": ["🔈", "🔉", "🔊"]
    },
    "on-click": "pavucontrol",
    "on-click-right": "~/.local/bin/volume-control-all toggle"
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%Y-%m-%d %H:%M:%S}"
  },

  "tray": {
    "icon-size": 18,
    "spacing": 10
  }
}
