#!/usr/bin/env bash

# Tmux session script for vudz_nixos development
SESSION_NAME="vudz_nixos"
PROJECT_DIR="$HOME/src/vudz_nixos"

# Check if session already exists
if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    # If we're not already in tmux, attach to the session
    if [ -z "$TMUX" ]; then
        tmux attach-session -t "$SESSION_NAME"
    else
        # If we're already in tmux, switch to the session
        tmux switch-client -t "$SESSION_NAME"
    fi
else
    # Create new session with claude code
    tmux new-session -d -s "$SESSION_NAME" -c "$PROJECT_DIR" -n "claude"

    # Start claude code in the first window
    tmux send-keys -t "$SESSION_NAME:claude" "cd $PROJECT_DIR && claude" C-m

    # Attach to the session
    if [ -z "$TMUX" ]; then
        tmux attach-session -t "$SESSION_NAME"
    else
        tmux switch-client -t "$SESSION_NAME"
    fi
fi
