### Styles

# Resolution
output Virtual-1 mode 4096x2160@60Hz scale 2
exec env WLR_NO_HARDWARE_CURSORS=1

seat * xcursor_theme default 128

# Gaps
gaps inner 10

# Set default terminal
set $term alacritty

# User Super key as modifier
set $mod Mod4

### Bindings

# Launch terminal
bindsym $mod+Return exec $term

# Launch browser
bindsym $mod+b exec chromium

# Launch appplication launcher
bindsym $mod+d exec rofi --show drun

# Close window
bindsym $mod+q kill

# Reload config
bindsym $mod+Shift+r reload

# Exit sway
bindsym $mod+Shift+q swaymsg exit

### Workspace Controls

# Switch Workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4

# Move focus window to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2

# Focus & Movement
bindsym $mod+Left focus left
bindsym $mod+Down focus downm
bindsym $mod+Up focus up
bindsym $mod+Right focus Right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move Down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### Bar

bar {
  swaybar_command waybar
}

### Boot setup

assign [app_id="chromium-browser"] 2
assign [app_id="Alacritty"] 1

exec $term
exec chromium

