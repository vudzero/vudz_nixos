### Styles

# Resolution
output Virtual-1 mode 4096x2160@60Hz scale 2
exec env WLR_NO_HARDWARE_CURSORS=1

seat * xcursor_theme default 128

# Minimal borders to show focused window
default_border pixel 2
default_floating_border pixel 2

# Border colors (focused window will be highlighted)
client.focused          #0080ff #0080ff #ffffff #0080ff #0080ff
client.focused_inactive #333333 #333333 #888888 #333333 #333333
client.unfocused        #333333 #333333 #888888 #333333 #333333
client.urgent           #ff0000 #ff0000 #ffffff #ff0000 #ff0000

# Gaps
gaps inner 10

# Set default terminal
set $term alacritty

# User Super key as modifier
set $mod Mod4

### Bindings

# Launch terminal
bindsym $mod+Return exec $term

# Launch browser
bindsym $mod+b exec chromium

# Launch application launcher
bindsym $mod+Shift+space exec rofi -show drun

# Close window
bindsym $mod+q kill

# Copy/Paste
bindsym $mod+c exec wtype -M ctrl -M shift c -m shift -m ctrl
bindsym $mod+v exec wtype -M ctrl -M shift v -m shift -m ctrl

# Reload config
bindsym $mod+Shift+r reload

# Exit sway
bindsym $mod+Shift+q exec swaymsg exit

### Workspace Controls

# Switch Workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4

# Move focus window to workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2

# Focus & Movement
bindsym $mod+Left focus left
bindsym $mod+Down focus downm
bindsym $mod+Up focus up
bindsym $mod+Right focus Right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move Down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### Bar

bar {
  swaybar_command waybar
}

### Boot setup

# Properly announce Wayland session to systemd for XDG desktop portal
exec systemctl --user import-environment XDG_SESSION_TYPE XDG_CURRENT_DESKTOP
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

# Launch terminal on workspace 1 and chromium on workspace 2 at boot, then focus back to workspace 1
exec bash -c 'swaymsg "workspace 1; exec $term"; sleep 0.5; swaymsg "workspace 2; exec chromium"; sleep 0.5; swaymsg "workspace 1"'

